<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- USB cable networking is plain TCP; Wi-Fi is never required. NSD is the
         Bonjour equivalent (_infernet-rpc._tcp, same TXT as iOS RPCAdvertiser). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.vulkan.compute" android:required="false" />
    <uses-feature android:name="android.hardware.opengles.aep" android:required="false" />
    <meta name="androidVersion" content="10+" />

    <application
        android:label="Backburner"
        android:theme="@style/Theme.Backburner"
        android:allowBackup="false"
        android:largeHeap="true"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:keepScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Holds the three servers off the main thread, like the iOS
             DispatchQueue.global(qos:.userInitiated) startRPC/startTail blocks.
             Sticky so a USB replug / low-memory kill restarts the listeners. -->
        <service
            android:name=".BackburnerService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
</manifest>
